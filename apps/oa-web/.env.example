# Copy to .env.local. These origins are read by the development proxy only.
# A configured, running O2OA server is required for live use.
# Ports below are EXAMPLES: use the isolated server's actual origins.
OA_O2_AUTH_ORIGIN=http://127.0.0.1:20020
OA_O2_PROCESS_ORIGIN=http://127.0.0.1:20020

# Public browser configuration. Never place a password or token here.
VITE_OA_API_BASE=/o2-api
VITE_OA_PLATFORM_WEB_URL=http://127.0.0.1:20030
