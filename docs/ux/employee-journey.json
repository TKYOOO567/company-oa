{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "员工 OA 旅程与本轮交互目标",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "frontend": {
          "label": "员工界面"
        },
        "backend": {
          "label": "终态核对"
        },
        "security": {
          "label": "身份与权限"
        },
        "external": {
          "label": "原生表单"
        }
      }
    }
  },
