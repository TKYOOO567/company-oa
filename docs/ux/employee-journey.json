      "from": "inbox",
      "to": "summary",
      "label": "打开记录",
      "role": "main"
    },
    {
      "from": "summary",
      "to": "nativeform",
      "label": "进入表单",
      "role": "main"
    },
    {
      "from": "nativeform",
      "to": "tracking",
      "label": "返回并刷新",
      "role": "main"
    },
    {
      "from": "tracking",
      "to": "closed",
      "label": "终态确认",
      "role": "main"
    },
    {
      "from": "home",
      "to": "startable",
      "label": "新申请",
      "role": "branch"
    },
    {
      "from": "startable",
      "to": "draft",
      "label": "选择流程",
      "role": "branch"
    },
    {
      "from": "draft",
      "to": "nativeform",
      "label": "打开草稿",
      "role": "branch"
    },
    {
      "from": "signin",
      "to": "accessfailure",
      "label": "登录失败",
      "role": "error",
      "variant": "security"
    },
    {
      "from": "accessfailure",
      "to": "signin",
      "label": "修正后重试",
      "role": "return"
    },
    {
      "from": "summary",
      "to": "retry",
      "label": "请求失败或拒绝",
      "role": "error",
      "variant": "security"
    },
    {
      "from": "nativeform",
      "to": "retry",
      "label": "办理未确认",
      "role": "error",
      "variant": "security"
    },
    {
      "from": "retry",
      "to": "summary",
      "label": "返回记录重试",
      "role": "return"
    },
    {
      "from": "retry",
      "to": "accessfailure",
      "label": "会话失效",
      "role": "return"
    }
