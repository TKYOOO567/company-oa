  "cards": [
    {
      "dot": "cyan",
      "title": "入口必须可信",
      "items": [
        "未登录只显示登录与连接",
        "登录后所有导航都有明确去向"
      ]
    },
    {
      "dot": "emerald",
      "title": "沿用原生执行",
      "items": [
        "动态表单与路由遵循有效配置",
        "返回新 Web 后重新读取状态"
      ]
    },
    {
      "dot": "amber",
      "title": "目标不等于已完成",
      "items": [
        "客户、资金、完整会计继续建设",
